{
  "manifest_version": 3,
  "name": "Chrome Bridge",
  "version": "1.0.0",
  "description": "Local bridge for controlled browser access",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "identity",
    "identity.email",
    "alarms",
    "storage",
    "nativeMessaging",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
